{
	"name": "radan-ui-monorepo",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "turbo run typecheck",
		"lint": "pnpm --filter @radandevist/radan-ui build:lint-plugin && oxlint --quiet --ignore-pattern 'packages/radan-ui/tests/fixtures/**' --ignore-pattern 'apps/expo-consumer/**' .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test": "turbo run test",
		"build": "turbo run build",
		"check:package": "turbo run check:package",
		"size": "turbo run size",
		"build:lint-plugin": "pnpm --filter @radandevist/radan-ui build:lint-plugin",
		"catalog:dev": "turbo run build --filter=@radandevist/radan-ui && pnpm --filter catalog dev",
		"catalog:build": "turbo run build --filter=catalog",
		"test:visual": "pnpm --filter catalog test:visual",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check:package && pnpm size"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.92.0",
		"turbo": "^2.9.0"
	}
}
