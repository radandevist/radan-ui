{
	"name": "@radandevist/radan-ui",
	"version": "0.1.2",
	"description": "Theme, React components and lint rules shared by Radan's apps",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radandevist/radan-ui.git"
	},
	"homepage": "https://radandevist.github.io/radan-ui/",
	"bugs": "https://github.com/radandevist/radan-ui/issues",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.13.1",
	"files": [
		"dist",
		"lint",
		"docs",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"bin": {
		"radan-ui": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./oxlint.json": "./lint/oxlint.json",
		"./oxfmt.json": "./lint/oxfmt.json",
		"./lint/*": "./lint/*",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "pnpm build:lint-plugin && oxlint --quiet --ignore-pattern 'tests/fixtures/**' --ignore-pattern 'dist/**' --ignore-pattern 'catalog/dist/**' .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test": "vitest run",
		"build": "rm -rf dist && tsdown && pnpm build:theme",
		"build:theme": "tsx scripts/build-theme.ts",
		"build:lint-plugin": "tsdown --config tsdown.lint.config.ts",
		"check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./theme.css",
		"size": "size-limit",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check:package && pnpm size"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@oxlint/plugins": "^1.92.0",
		"@size-limit/file": "^14.3.0",
		"@types/node": "^24.19.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.92.0",
		"publint": "^0.3.25",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
