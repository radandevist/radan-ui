{
	"plugins": ["unicorn", "typescript", "oxc", "react", "vitest"],
	"jsPlugins": [
		{ "name": "house", "specifier": "./plugins/house/index.js" },
		{ "name": "anti-slop", "specifier": "./plugins/anti-slop/index.js" }
	],
	"categories": { "correctness": "error" },
	"env": { "builtin": true, "browser": true, "node": true, "es2024": true },
	"settings": { "react": { "version": "19.3" } },
	"rules": {
		"curly": "error",
		"no-else-return": "error",
		"func-style": ["error", "expression"],
		"no-nested-ternary": "error",
		"no-param-reassign": "error",
		"default-param-last": "error",
		"react/self-closing-comp": "error",
		"react/rules-of-hooks": "error",
		"react/error-boundaries": "error",
		"react/globals": "error",
		"react/immutability": "error",
		"react/incompatible-library": "error",
		"react/preserve-manual-memoization": "error",
		"react/purity": "error",
		"react/refs": "error",
		"react/set-state-in-effect": "error",
		"react/set-state-in-render": "error",
		"react/static-components": "error",
		"react/use-memo": "error",
		"react/void-use-memo": "error",
		"react/unsupported-syntax": "error",
		"react/no-deriving-state-in-effects": "error",
		"react/invariant": "error",
		"react/rule-suppression": "error",
		"react/syntax": "error",
		"react/todo": "error",
		"react/capitalized-calls": "error",
		"react/exhaustive-effect-dependencies": "error",
		"react/hooks": "error",
		"react/memo-dependencies": "error",
		"typescript/no-deprecated": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-inferrable-types": "error",
		"typescript/no-misused-spread": "error",
		"typescript/unbound-method": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/prefer-as-const": "error",
		"unicorn/no-array-for-each": "error",
		"unicorn/no-document-cookie": "error",
		"unicorn/prefer-number-properties": "error",
		"complexity": ["error", { "max": 60 }],
		"house/arrow-function-components": "error",
		"house/no-array-reduce": "error",
		"house/no-console-in-source": "error",
		"house/no-iife": "error",
		"house/no-never-any-casts": "error",
		"house/prefer-early-return": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error"
	},
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"rules": { "complexity": ["error", { "max": 90 }] }
		},
		{
			"files": ["tools/**", "scripts/**"],
			"rules": { "complexity": ["error", { "max": 125 }] }
		}
	]
}
